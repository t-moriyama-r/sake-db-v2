{
  "name": "sake-db-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https",
    "sandbox": "npx ampx sandbox --profile sake-db",
    "start:local": "concurrently \"npm run sandbox\" \"npm run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "cross-env AWS_PROFILE=sake-db npx tsx scripts/seed.ts",
    "seed:dry-run": "cross-env AWS_PROFILE=sake-db npx tsx scripts/seed.ts --dry-run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "aws-amplify": "^6.16.3",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.21.1",
    "@aws-amplify/backend-cli": "^1.8.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk-lib": "^2.234.1",
    "concurrently": "^9.2.1",
    "constructs": "^10.5.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
